// DVA Volleyball Club - Prisma Schema
// Optimized for PostgreSQL (Neon.tech / Supabase / Railway)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  PLAYER
}

enum PlayerLevel {
  KID
  JUNIOR
  SENIOR
}

enum Position {
  OH // Outside Hitter (Chủ công)
  OP // Opposite Hitter (Đối chuyền)
  MB // Middle Blocker (Phụ công)
  S  // Setter (Chuyền hai)
  L  // Libero (Chuyên gia phòng ngự)
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RotationKnowledge {
  ROTATION_5_1
  ROTATION_6_2
  ROTATION_4_2
  UNKNOWN
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  fullName     String
  phoneNumber  String?
  role         Role          @default(PLAYER)
  player       Player?
  newsPosts    NewsPost[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("users")
}

model Player {
  id              String      @id @default(uuid())
  userId          String?     @unique
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName        String
  jerseyNumber    Int
  height          Float       // in cm (e.g. 192.0)
  weight          Float       // in kg (e.g. 84.0)
  spikeTouch      Float       // bật đà in cm (e.g. 348.0)
  blockTouch      Float       // bật chắn in cm (e.g. 332.0)
  hometownCountry String      // e.g. "Hà Nội, VN"
  countryCode     String      @default("VN")
  level           PlayerLevel @default(SENIOR)
  position        Position    @default(OH)
  avatarUrl       String?
  bio             String?     @db.Text
  isCaptain       Boolean     @default(false)
  joinedYear      Int         @default(2025)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("players")
}

model Court {
  id          String    @id @default(uuid())
  code        String    @unique // 'SAN_TT', 'SAN_1', 'SAN_2'
  name        String
  description String    @db.Text
  floorType   String    // 'Taraflex Pro Elite 7.5mm'
  hourlyRate  Decimal   @default(550000.00) @db.Decimal(12, 2)
  minHours    Float     @default(1.5)
  isAvailable Boolean   @default(true)
  imageUrl    String?
  bookings    Booking[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("courts")
}

model Booking {
  id            String        @id @default(uuid())
  courtId       String
  court         Court         @relation(fields: [courtId], references: [id])
  customerName  String
  customerEmail String
  customerPhone String
  bookingDate   DateTime      @db.Date
  startTime     String        // e.g. "18:00"
  endTime       String        // e.g. "20:00"
  totalHours    Float         // e.g. 2.0
  courtPrice    Decimal       @db.Decimal(12, 2)
  addons        Json?         // { mineralWaterBottles: 6, mikasaBallCrate: true, certifiedReferee: false }
  addonsPrice   Decimal       @default(0.00) @db.Decimal(12, 2)
  totalPrice    Decimal       @db.Decimal(12, 2)
  paymentStatus PaymentStatus @default(PENDING)
  bookingCode   String        @unique // e.g. DVA-TT-20261020-4821
  bankRef       String?       // "MB Bank - 0002090671521"
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("bookings")
}

model TrainingCourse {
  id             String                 @id @default(uuid())
  title          String
  level          String
  coachName      String
  coachTitle     String
  schedule       String
  duration       String
  price          Decimal                @db.Decimal(12, 2)
  description    String                 @db.Text
  targetAudience String                 @db.Text
  curriculum     Json                   // array of strings
  maxSlots       Int                    @default(16)
  enrolledSlots  Int                    @default(0)
  registrations  TrainingRegistration[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@map("training_courses")
}

model TrainingRegistration {
  id                String         @id @default(uuid())
  courseId          String
  course            TrainingCourse @relation(fields: [courseId], references: [id])
  fullName          String
  email             String
  phone             String
  experienceLevel   String
  preferredTimeSlot String
  notes             String?        @db.Text
  status            String         @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("training_registrations")
}

model NewsPost {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  excerpt         String   @db.Text
  content         String   @db.Text
  thumbnail       String?
  category        String   // GIẢI ĐẤU, HOẠT ĐỘNG CLB, KỸ THUẬT, TUYỂN QUÂN
  authorId        String
  author          User     @relation(fields: [authorId], references: [id])
  readTimeMinutes Int      @default(4)
  featured        Boolean  @default(false)
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("news_posts")
}

model MemberApplication {
  id                  String            @id @default(uuid())
  fullName            String
  dob                 DateTime          @db.Date
  position            Position
  hometownCountry     String
  desiredJerseyNumber Int
  level               PlayerLevel
  height              Float
  weight              Float
  spikeReach          Float
  blockReach          Float
  gmail               String
  instagram           String            @default("Không có")
  zalo                String
  rotationKnowledge   RotationKnowledge @default(ROTATION_5_1)
  status              ApplicationStatus @default(PENDING)
  reviewNotes         String?           @db.Text
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@map("member_applications")
}
