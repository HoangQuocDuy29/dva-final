# ==============================================================================
# DVA VOLLEYBALL CLUB - BACKEND ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# Cổng khởi chạy ứng dụng (Render/Cloud sẽ tự động cấp biến PORT)
PORT=5000

# Môi trường chạy (development | production)
NODE_ENV=production

# Bật trust proxy khi chạy sau Reverse Proxy của Render / Railway / Cloud
TRUST_PROXY=1

# CLIENT_URL: Frontend domain được phép truy cập CORS (Vercel deployment hoặc custom domain)
CLIENT_URL=http://localhost:5173

# VITE_API_URL: Base URL của backend API dùng cho Frontend (Vite/React)
# Môi trường Local: http://localhost:5000
# Môi trường Production (Vercel): URL backend triển khai (https://dva-backend-jask.onrender.com)
VITE_API_URL=http://localhost:5000

# DATABASE_URL: PostgreSQL Connection String (Neon / Supabase / Render Postgres / Local)
DATABASE_URL="postgresql://user:password@host:5432/dva_db?sslmode=require"

# DIRECT_URL: URL kết nối trực tiếp (khi dùng Prisma migrate với Supabase/Neon connection pooler)
# DIRECT_URL="postgresql://postgres:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/dva_db"

# JWT_SECRET: Khóa bảo mật ký token JWT (tối thiểu 32 ký tự ngẫu nhiên trong production)
JWT_SECRET=replace-with-a-random-32-byte-secret-in-production

# Thời hạn hết hạn của JWT token tính bằng giờ (mặc định: 24)
JWT_EXPIRES_IN_HOURS=24

# Cấu hình tài khoản ngân hàng nhận thanh toán VietQR
BANK_ID=MB
BANK_ACCOUNT_NO=0002090671521
BANK_ACCOUNT_NAME="HOANG QUOC DUY"

# Cấu hình Webhook thanh toán tự động (SePay / Casso)
PAYMENT_WEBHOOK_API_KEY=your_webhook_api_key_here

# Cấu hình dịch vụ gửi Email thông báo qua SMTP Gmail
EMAIL_USER=dvavolleyballclub@gmail.com
EMAIL_PASS=your_app_password
ADMIN_NOTIFICATION_EMAIL=quocduyhoang42@gmail.com
EMAIL_FROM_NAME="DVA Volleyball Club System"
EMAIL_FROM_ADDRESS=dvavolleyballclub@gmail.com

# Thông số SMTP chi tiết (tùy chọn nếu cần cấu hình riêng)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=dvavolleyballclub@gmail.com
SMTP_PASS=your_app_password

# Tích hợp Google Sheets (Đồng bộ dữ liệu đặt sân, học viên, hội viên)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your_deployment_id/exec
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/your_deployment_id/exec
GOOGLE_SHEETS_SPREADSHEET_ID=your_google_sheets_spreadsheet_id_here
SPREADSHEET_ID=your_google_sheets_spreadsheet_id_here

# Google Service Account (Tùy chọn đọc/ghi trực tiếp Google Sheets API v4)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key\n-----END PRIVATE KEY-----\n"

# Cấu hình câu lạc bộ & Đặt sân
BOOKING_HOLD_MINUTES=15
HOTLINE="0768 299 329"
CLUB_ADDRESS="Sân Bóng Chuyền DVA, TP. Hồ Chí Minh"
CLUB_MAPS_URL="https://maps.google.com/?q=DVA+Volleyball"
COURT_GUIDE_IMAGE_URL="https://res.cloudinary.com/..."

# Cấu hình Cloudinary (Tùy chọn lưu trữ hình ảnh tải lên)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Cấu hình AI Gemini & Cloud Hosting App URL (Tùy chọn)
GEMINI_API_KEY=your_gemini_api_key
APP_URL=https://your-backend-app.onrender.com
