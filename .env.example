# ==============================================================================
# DVA VOLLEYBALL CLUB - BACKEND ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# Cổng khởi chạy ứng dụng (Render/Cloud sẽ tự động cấp biến PORT)
PORT=5000

# Môi trường chạy (development | production)
NODE_ENV=production

# Bật trust proxy khi chạy sau Reverse Proxy của Render / Railway / Cloud
TRUST_PROXY=1

# CLIENT_URL: Frontend domain được phép truy cập CORS (Vercel deployment hoặc custom domain)
CLIENT_URL=http://localhost:5173

# VITE_API_URL: Base URL của backend API dùng cho Frontend (Vite/React)
# Môi trường Local: http://localhost:5000
# Môi trường Production (Vercel): URL backend triển khai (https://dva-backend-jask.onrender.com)
VITE_API_URL=http://localhost:5000

# DATABASE_URL: PostgreSQL Connection String (Runtime Backend)
# Production sử dụng Supabase Transaction Pooler (IPv4, port 6543, Region Singapore ap-southeast-1) để giải phóng backend Postgres ngay sau mỗi transaction (giảm RAM trên gói Free Nano).
# Tham số ?uselibpqcompat=true&sslmode=require giúp thư viện `pg` v8+ kết nối SSL sạch, không cảnh báo alias.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?uselibpqcompat=true&sslmode=require"

# DIRECT_URL: Dùng cho Prisma CLI (`npx prisma db push` qua prisma.config.ts) & backup — trỏ Session Pooler IPv4 (port 5432) để tương thích mạng IPv4 trên Render/local.
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require"

# Tùy chỉnh pg.Pool nếu nâng cấp gói DB (mặc định: PG_POOL_MAX=5, PG_POOL_IDLE_TIMEOUT_MS=10000)
# PG_POOL_MAX=5
# PG_POOL_IDLE_TIMEOUT_MS=10000

# LOCAL_DATABASE_URL: PostgreSQL Local trên máy (pgAdmin 4 / Docker Postgres 15-17) để đồng bộ dự phòng từ Supabase bằng `npm run db:sync-local`
LOCAL_DATABASE_URL="postgresql://postgres:<LOCAL_PG_PASSWORD>@localhost:5432/dva_volleyball"

# JWT_SECRET: Khóa bảo mật ký token JWT (tối thiểu 32 ký tự ngẫu nhiên trong production)
JWT_SECRET=replace-with-a-random-32-byte-secret-in-production

# Thời hạn hết hạn của JWT token tính bằng giờ (mặc định: 24)
JWT_EXPIRES_IN_HOURS=24

# Seed password mặc định cho bootstrap tài khoản lần đầu (Tùy chọn)
# SEED_SUPERADMIN_PASSWORD=your_superadmin_password
# SEED_ADMIN_PASSWORD=your_admin_password
# SEED_PLAYER_PASSWORD=your_player_password

# Cấu hình tài khoản ngân hàng nhận thanh toán VietQR
BANK_ID=MB
BANK_ACCOUNT_NO=0002090671521
BANK_ACCOUNT_NAME="HOANG QUOC DUY"

# Cấu hình Webhook thanh toán tự động (SePay / Casso - đọc PAYMENT_WEBHOOK_API_KEY | SEPAY_API_KEY | CASSO_API_KEY)
PAYMENT_WEBHOOK_API_KEY=your_webhook_api_key_here

# Cấu hình dịch vụ gửi Email giao dịch song ngữ qua Resend API (lib/mailer.ts)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="DVA Volleyball <contact@dva-volleyball-hanoi.com>"
ADMIN_NOTIFY_EMAIL=quocduyhoang42@gmail.com

# Tích hợp Google Sheets (Đồng bộ dữ liệu qua Google Apps Script Webhook & liên kết xem bảng tính)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your_deployment_id/exec
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/your_deployment_id/exec
GOOGLE_SHEETS_URL=https://docs.google.com/spreadsheets/d/your_google_sheets_spreadsheet_id_here/edit
GOOGLE_SHEETS_SPREADSHEET_ID=your_google_sheets_spreadsheet_id_here
SPREADSHEET_ID=your_google_sheets_spreadsheet_id_here

# Cấu hình câu lạc bộ & Đặt sân
BOOKING_HOLD_MINUTES=15
HOTLINE="0768 299 329"
CLUB_ADDRESS="Sân Bóng Chuyền DVA, TP. Hồ Chí Minh"
CLUB_MAPS_URL="https://maps.google.com/?q=DVA+Volleyball"
COURT_GUIDE_IMAGE_URL="https://res.cloudinary.com/..."

# Cấu hình Cloudinary (Tùy chọn lưu trữ hình ảnh tải lên)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Cấu hình AI Gemini & Cloud Hosting App URL (Tùy chọn)
GEMINI_API_KEY=your_gemini_api_key
APP_URL=https://your-backend-app.onrender.com
