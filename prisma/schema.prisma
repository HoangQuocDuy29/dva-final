// ============================================================================
// DVA Volleyball Club - Prisma ORM Schema
// Target Database: PostgreSQL (Supabase / Neon)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: url được quản lý qua prisma.config.ts (CLI) và adapter trong lib/prisma.ts (runtime)
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  SUPERADMIN
  ADMIN
  STAFF
  COACH
  CAPTAIN
  PLAYER
  GUEST
}

enum PlayerLevel {
  SENIOR
  JUNIOR
  YOUTH
}

enum VolleyballPosition {
  OH // Outside Hitter (Chủ công)
  OP // Opposite Hitter (Đối chuyền)
  MB // Middle Blocker (Phụ công)
  S  // Setter (Chuyền hai)
  L  // Libero
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  SCHEDULED
  RETEST
  APPROVED
  REJECTED
}

enum RotationKnowledge {
  ROTATION_5_1 @map("5-1")
  ROTATION_6_2 @map("6-2")
  ROTATION_4_2 @map("4-2")
  BEGINNER
}

// ============================================================================
// MODELS
// ============================================================================

/// Tài khoản người dùng và phân quyền quản trị (RBAC)
model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  fullName     String
  phoneNumber  String?
  avatarUrl    String?
  role         UserRole   @default(PLAYER)
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  tokenVersion Int        @default(1)

  // Relations
  player        Player?
  newsPosts     NewsPost[]
  captainedClub CourtClubProfile?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([role])
  @@map("users")
}

/// Hồ sơ vận động viên / cầu thủ thuộc CLB DVA
model Player {
  id              String             @id @default(uuid())
  userId          String?            @unique
  user            User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  fullName        String
  jerseyNumber    Int
  height          Float              // Chiều cao (cm)
  weight          Float              // Cân nặng (kg)
  spikeTouch      Float              // Tầm bật đà (cm)
  blockTouch      Float              // Tầm bật chắn (cm)
  hometownCountry String             // Quê quán / Thành phố (VD: "Hà Nội")
  countryName     String?            @default("Vietnam")
  countryCode     String             @default("VN")
  countryFlag     String?            @default("🇻🇳")
  bornYear        Int?
  level           PlayerLevel        @default(JUNIOR)
  position        VolleyballPosition @default(OH)
  avatarUrl       String?
  bio             String?            @db.Text
  isCaptain       Boolean            @default(false)
  joinedYear      Int                @default(2025)
  isActive        Boolean            @default(true) // Soft visibility flag (Public vs Admin)

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([level, position])
  @@index([jerseyNumber])
  // Performance: [level =] -> [isCaptain DESC] -> [jerseyNumber ASC] (đội trưởng lên đầu theo từng đội hình)
  @@index([level, isCaptain(sort: Desc), jerseyNumber(sort: Asc)])
  // Performance: sắp xếp / tìm kiếm theo tên trong từng đội hình
  @@index([level, fullName(sort: Asc)])
  @@index([isActive])
  @@map("players")
}

/// Sân bóng chuyền thuộc hệ thống DVA (BTL Thông Tin, Thể Công, Mỹ Đình)
model Court {
  id             String       @id @default(uuid())
  code           String       @unique // VD: 'BTL_TT', 'THE_CONG', 'MY_DINH'
  shortName      String?      // VD: 'BTL TT', 'THE CONG', 'MY DINH'
  name           String
  address        String?      @default("DVA Sports Center, Hà Nội")
  description    String       @db.Text
  floorType      String       // VD: 'Taraflex Pro Elite 7.5mm (Injury-Preventive)'
  hourlyRate     Int          @default(500000) // Đơn giá theo giờ (VND)
  minHours       Float        @default(1.5)
  includes       String[]     // Danh sách tiện ích đi kèm
  imageUrl       String
  status         String       @default("ACTIVE") // 'ACTIVE' | 'MAINTENANCE'
  isMaintenance  Boolean      @default(false)
  isAvailable    Boolean      @default(true)
  isActive       Boolean      @default(true) // Soft delete flag
  weeklySchedule Json?        // Cấu hình khung giờ 7 ngày: { monday: ["17:30 - 19:30", ...], ..., sunday: [...] }
  subCourts      String[]     @default([]) // Danh sách sân con (VD: ['Sân A', 'Sân B'] cho cụm BTL Thông Tin)

  // Relations
  bookings       Booking[]
  closedSlots    ClosedSlot[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("courts")
}

/// Các ca sân bị khóa thủ công bởi Admin (bảo trì, giao hữu nội bộ, khách thuê cố định)
model ClosedSlot {
  id        String   @id @default(uuid())
  courtId   String
  court     Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  courtName String
  subCourt  String   @default("") // 'Sân A' | 'Sân B' nếu khóa riêng sân con, hoặc '' nếu khóa chung
  date      String   // Định dạng YYYY-MM-DD
  slotLabel String   // Định dạng "HH:mm - HH:mm" (VD: "17:30 - 19:00")
  reason    String?
  closedBy  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courtId, date, slotLabel, subCourt])
  @@index([courtId, date])
  @@index([courtId, date, subCourt])
  // Performance: xem toàn bộ ca đóng sân theo ngày (không bắt buộc courtId)
  @@index([date, courtId])
  // Performance: ca đóng sân gần nhất theo sân + ngày
  @@index([courtId, date, createdAt(sort: Desc)])
  @@map("closed_slots")
}

/// Đơn đặt sân và theo dõi trạng thái thanh toán VietQR
model Booking {
  id                  String        @id @default(uuid())
  bookingCode         String        @unique // VD: "DVA-BTL-20261023-3884"
  courtId             String
  court               Court         @relation(fields: [courtId], references: [id], onDelete: Restrict)
  courtName           String
  subCourt            String?       // 'Sân A' | 'Sân B' cho cụm sân chia sân con

  customerName        String
  customerEmail       String
  customerPhone       String

  bookingDate         String        // Định dạng YYYY-MM-DD
  startTime           String        // Định dạng HH:mm (VD: "17:30")
  endTime             String        // Định dạng HH:mm (VD: "19:00")
  totalHours          Float

  courtPrice          Int           // Tiền thuê sân (VND)
  addons              Json          // { mineralWaterBottles: Int, mikasaBallCrate: Boolean, certifiedReferee: Boolean }
  addonsPrice         Int           @default(0) // Tiền dịch vụ cộng thêm (VND)
  totalPrice          Int           // Tổng thanh toán (VND)

  paymentStatus       PaymentStatus @default(PENDING)
  transferContent     String?       // Nội dung chuyển khoản VietQR
  notes               String?       @db.Text

  customerConfirmedAt DateTime?     // Thời điểm khách bấm xác nhận đã chuyển khoản
  holdExpiresAt       DateTime?     // Thời điểm hết hạn giữ chỗ tạm thời (15 phút)

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([courtId, bookingDate, paymentStatus])
  @@index([courtId, bookingDate, subCourt])
  @@index([paymentStatus, holdExpiresAt])
  // Performance: lịch đặt sân theo sân + ngày, sort theo giờ bắt đầu (hasBookingConflict, CourtBookingPage)
  @@index([courtId, bookingDate, startTime(sort: Asc)])
  // Performance: lịch đặt theo ngày trên toàn hệ thống
  @@index([bookingDate, startTime(sort: Asc)])
  // Performance: GET /api/bookings (lọc sân + ngày, sort createdAt DESC)
  @@index([courtId, bookingDate, createdAt(sort: Desc)])
  // Performance: webhook đối soát thanh toán - đơn PENDING mới nhất
  @@index([paymentStatus, createdAt(sort: Desc)])
  // Performance: Admin Dashboard - 100 đơn mới nhất
  @@index([createdAt(sort: Desc)])
  // Performance: tra cứu lịch sử đặt sân theo khách hàng
  @@index([customerEmail])
  @@index([customerPhone])
  @@map("bookings")
}

/// Hồ sơ huấn luyện viên học viện DVA
model CoachProfile {
  id             String           @id @default(uuid())
  name           String
  role           String
  experience     String
  height         String
  age            Int
  bornYear       Int
  avatarUrl      String
  specialty      String
  bio            String           @db.Text
  certifications String[]

  // Relations
  courses        TrainingCourse[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("coaches")
}

/// Khóa học bóng chuyền & các ca ghép đội đấu tập (Scrimmage)
model TrainingCourse {
  id             String                 @id @default(uuid())
  title          String
  level          String
  tag            String?
  targetAudience String                 @db.Text
  price          Int                    // Học phí / Phí tham gia (VND)
  priceUnit      String?                // VD: "/ player / session"
  schedule       String
  duration       String

  coachId        String?
  coach          CoachProfile?          @relation(fields: [coachId], references: [id], onDelete: SetNull)
  coachName      String
  coachTitle     String

  description    String                 @db.Text
  benefits       String[]
  curriculum     String[]
  maxSlots       Int                    @default(16)
  enrolledSlots  Int                    @default(0)
  imageUrl       String?
  isActive       Boolean                @default(true) // Soft visibility flag (Public vs Admin)

  // Relations
  registrations  TrainingRegistration[]

  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([isActive])
  @@map("training_courses")
}

/// Đơn đăng ký tham gia khóa học / ghép đội đấu tập
model TrainingRegistration {
  id                String             @id @default(uuid())
  courseId          String
  course            TrainingCourse     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseTitle       String

  fullName          String
  email             String
  phone             String
  experienceLevel   String
  preferredTimeSlot String
  notes             String?            @db.Text
  status            RegistrationStatus @default(PENDING)

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([courseId, status])
  // Performance: lọc khóa + trạng thái, sort ngày đăng ký DESC
  @@index([courseId, status, createdAt(sort: Desc)])
  // Performance: lọc trạng thái, danh sách mới nhất
  @@index([status, createdAt(sort: Desc)])
  // Performance: GET /api/training/registrations & Admin Dashboard (orderBy createdAt DESC)
  @@index([createdAt(sort: Desc)])
  // Performance: tra cứu học viên theo email / số điện thoại
  @@index([email])
  @@index([phone])
  @@map("training_registrations")
}

/// Hồ sơ ứng tuyển thành viên CLB (Tryout Application)
model MemberApplication {
  id                  String             @id @default(uuid())
  fullName            String
  dob                 String             // Định dạng YYYY-MM-DD
  position            VolleyballPosition
  hometownCountry     String
  desiredJerseyNumber Int
  level               PlayerLevel
  height              Float              // Chiều cao (cm)
  weight              Float              // Cân nặng (kg)
  spikeReach          Float              // Tầm bật đà (cm)
  blockReach          Float              // Tầm bật chắn (cm)
  gmail               String
  instagram           String             @default("None")
  zalo                String
  rotationKnowledge    RotationKnowledge  @default(ROTATION_5_1)
  status               ApplicationStatus  @default(PENDING)
  paymentStatus        String             @default("PENDING") // "PENDING" | "PAID" | "FREE"
  paidAt               DateTime?          // Thời điểm Admin xác nhận đã đóng lệ phí try-out
  entryFee             Int                @default(100000) // Lệ phí gia nhập / Try-Out CLB (VNĐ) — mặc định 100.000đ, 0đ nếu FREE
  approvedAt           DateTime?          // Thời điểm Admin duyệt hồ sơ (dùng để gom nhóm doanh thu theo tháng)
  reviewNotes          String?            @db.Text
  experience           String?            // Kinh nghiệm chơi bóng (từ form Try-Out hoặc ghi chú)
  preferredDays        String?            // Khung ngày/giờ Try-Out mong muốn
  evaluationScores     Json?              // Phiếu chấm điểm 4 tiêu chí (1-5 mỗi tiêu chí, tổng / 20)
  coachNotes           String?            @db.Text // Nhận xét chuyên môn của HLV trên phiếu chấm
  scheduledAt          DateTime?          // Thời điểm lịch hẹn Try-Out
  scheduledDate        String?            // Ngày hẹn Try-Out (YYYY-MM-DD)
  scheduledDayLabel    String?            // Thứ trong tuần tương ứng (VD: "Thứ Hai (Monday)")
  scheduledTime        String?            // Khung giờ hẹn Try-Out (VD: "18:00 - 19:00")
  scheduledNotes       String?            @db.Text // Ghi chú riêng của HLV/Admin trong thư mời Try-Out
  scheduledEmailSentAt DateTime?          // Thời điểm gửi email hẹn lịch gần nhất
  scheduleHistory      Json?              // Lịch sử các lần gửi thư mời hẹn Try-Out
  resultEmailSentAt    DateTime?          // Thời điểm gửi email thông báo kết quả (APPROVED / REJECTED)
  resultEmailHistory   Json?              // Lịch sử gửi email thông báo kết quả

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status, level])
  @@index([paymentStatus])
  // Performance: lọc trạng thái (+ đội hình), sort ngày nộp DESC
  @@index([status, level, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  // Performance: GET member applications & Admin Dashboard (orderBy createdAt DESC)
  @@index([createdAt(sort: Desc)])
  // Performance: tra cứu hồ sơ theo gmail
  @@index([gmail])
  @@map("member_applications")
}

/// Bài viết tin tức, giải đấu và kiến thức kỹ thuật
model NewsPost {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  excerpt         String   @db.Text
  content         String   @db.Text
  thumbnail       String   @default("")
  category        String   // TOURNAMENT, CLUB_EVENT, TECHNIQUE, TRYOUT, ...

  authorId        String?
  author          User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName      String
  authorRole      String

  publishedAt     String   // Định dạng YYYY-MM-DD hoặc ISO
  readTimeMinutes Int      @default(4)
  featured        Boolean  @default(false)
  isPinned        Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category, featured])
  @@index([isPinned, publishedAt(sort: Desc)])
  @@map("news_posts")
}

/// Cấu hình hệ thống (Webhook Google Apps Script, v.v.)
model AppConfig {
  id              String   @id @default("default")
  googleScriptUrl String   @default("")
  updatedAt       DateTime @updatedAt

  @@map("app_config")
}

/// Nhật ký đồng bộ Google Sheets
model GoogleSheetsSyncLog {
  id        String   @id @default(uuid())
  tabName   String   // Member_Registrations, Court_Bookings, Training_Registrations
  action    String   @default("APPEND_ROW")
  rowData   Json
  status    String   @default("SUCCESS")
  timestamp DateTime @default(now())

  // Performance: lịch sử đồng bộ mới nhất theo tab (thay thế index [tabName, timestamp] ASC cũ
  // vì trùng tên mặc định `google_sheets_sync_logs_tabName_timestamp_idx`; B-tree DESC vẫn phục vụ được truy vấn ASC)
  @@index([tabName, timestamp(sort: Desc)])
  // Performance: tra cứu các lần đồng bộ FAILED gần nhất
  @@index([status, timestamp(sort: Desc)])
  // Performance: phân trang toàn bộ nhật ký
  @@index([timestamp(sort: Desc)])
  @@map("google_sheets_sync_logs")
}

// ============================================================================
// DVA SHOP MODULE (PHASE 2 - E-COMMERCE & MERCHANDISE)
// ============================================================================

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

enum DeliveryMethod {
  COURT_PICKUP
  HOME_DELIVERY
}

/// Sản phẩm chính hãng tại DVA Store (Áo đấu, Bó gối, Tất, Phụ kiện)
model Product {
  id            String      @id @default(uuid())
  sku           String      @unique // VD: 'DVA-JSY-SLV-01'
  slug          String?     // URL slug cho route '/shop/[category]/[product-slug]' (VD: 'dva-pro-jersey-2026')
  name          String
  category      String      // 'SLEEVELESS' | 'SHORT_SLEEVE' | 'WOMEN' | 'KNEE_PADS' | 'SOCKS' | 'JERSEYS' | 'VOLLEYBALLS' | 'TRAINING_GEAR' | 'ACCESSORIES'
  originalPrice Int?        // Giá gốc trước giảm (VNĐ) - nếu > price sẽ gạch ngang và hiện % giảm
  price         Int         // Giá bán thực tế sau giảm (VNĐ)
  stock         Int         @default(50)
  frontImage    String      // URL ảnh mặt trước (Cloudinary / local)
  backImage     String?     // URL ảnh mặt sau (hiển thị khi hover / zoom)
  sizes         String[]    @default(["S", "M", "L", "XL", "2XL"])
  colors        String[]    @default([])
  badge         String?     // Nhãn phân loại phụ (VD: 'NEW RELEASE', 'OFFICIAL MATCH', 'BEST SELLER')
  allowCustomPrint Boolean  @default(true) // Cho phép in tên thi đấu (Player Name)
  sortOrder     Int         @default(0) // Thứ tự ưu tiên hiển thị (số lớn hơn xếp trước)
  description   String?     @db.Text
  isPaused      Boolean     @default(false) // Tạm dừng bán (Temporarily Out of Stock / Coming Back Soon)
  isActive      Boolean     @default(true)

  // Relations
  orderItems    OrderItem[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([isActive, category])
  @@index([category, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("products")
}

/// Đơn đặt hàng DVA Shop & theo dõi thanh toán VietQR / vận chuyển
model Order {
  id                  String         @id @default(uuid())
  orderCode           String         @unique // VD: 'DVA-SHOP-20261110-849201'
  customerName        String
  customerPhone       String
  customerEmail       String?
  socialLink          String?        // Instagram / Facebook link hoặc handle
  deliveryMethod      DeliveryMethod @default(COURT_PICKUP)
  shippingAddress     String?        @db.Text
  quantity            Int            @default(1) // Số lượng đặt mua (nhân trực tiếp vào totalAmount)
  totalAmount         Int            // Tổng thanh toán (VNĐ) = price * quantity
  status              OrderStatus    @default(PENDING)
  transferContent     String         // Cú pháp VietQR: 'DVA [CAT_CODE] [ORDER_CODE_SUFFIX]'
  notes               String?        @db.Text

  customerConfirmedAt DateTime?      // Thời điểm khách bấm 'I Have Transferred / Confirm Order'
  shippingEmailSentAt DateTime?      // Thời điểm Admin bấm 'Send Shipping Update' (Email chặng 2)

  // Relations
  items               OrderItem[]

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([customerPhone])
  @@index([customerEmail])
  @@map("orders")
}

/// Chi tiết từng mặt hàng trong đơn hàng DVA Shop (kèm thông số in áo cá nhân hóa)
model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  productName  String
  category     String
  sku          String
  size         String?  // 'S' | 'M' | 'L' | 'XL' | 'XXL' | 'Free Size'
  color        String?
  quantity     Int      @default(1)
  unitPrice    Int      // Giá tại thời điểm đặt (VNĐ)

  // Thông số cá nhân hóa dành cho danh mục Áo (Jerseys)
  height       Float?   // Chiều cao khách (cm)
  weight       Float?   // Cân nặng khách (kg)
  customName   String?  // Tên in sau lưng áo
  customNumber String?  // Số áo in (VD: '10', '07')

  createdAt    DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ============================================================================
// VERIFIED CASHFLOW ANALYTICS - GUEST SESSIONS (DROP-IN PASS)
// ============================================================================

/// Lượt khách vãng lai tham gia Scrimmage / Drop-in Session (phát hành qua Guest Session Email)
model GuestSession {
  id                String        @id @default(uuid())
  guestName         String
  guestEmail        String
  phone             String?
  position          String        @default("OH")
  positionPrivilege String        @default("FIXED")
  level             String        @default("Junior")
  sessionDate       String        // Định dạng YYYY-MM-DD
  sessionTime       String        // VD: "19:00 - 21:30"
  courtAddress      String?
  amount            Int           // Phí giữ chỗ linh hoạt (VNĐ: 60000, 70000, 150000...)
  transferContent   String        @unique // Cú pháp VietQR duy nhất: "SCRIM <NAME> <DDMM> <HHMM> <POS> <RAND>"
  paymentStatus     PaymentStatus @default(PENDING)
  notes             String?       @db.Text
  paidAt            DateTime?     // Thời điểm xác nhận đã thu tiền (thủ công hoặc webhook)
  emailSentAt       DateTime      @default(now())

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([paymentStatus, createdAt(sort: Desc)])
  @@index([sessionDate])
  @@index([guestEmail, sessionDate, sessionTime])
  @@index([createdAt(sort: Desc)])
  @@map("guest_sessions")
}

// ============================================================================
// TOURNAMENTS & LEAGUES MODULE (SPEC 008)
// ============================================================================

enum TournamentMode {
  HOSTED
  PARTICIPATING
}

enum TournamentTrackingMode {
  FULL_BRACKET
  DVA_FOCUS
}

enum TournamentStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum MatchStage {
  GROUP
  POOL_A
  POOL_B
  QUARTERFINAL
  SEMIFINAL
  THIRD_PLACE
  FINAL
}

enum MatchStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum OfficialRole {
  MAIN_REFEREE
  LINE_JUDGE
  SCORER
  SUPERVISOR
}

/// Giải đấu bóng chuyền (Đăng cai HOSTED hoặc Đội khách PARTICIPATING)
model Tournament {
  id                   String                 @id @default(uuid())
  slug                 String                 @unique
  name                 String
  subtitle             String?
  mode                 TournamentMode         @default(HOSTED)
  trackingMode         TournamentTrackingMode @default(FULL_BRACKET)
  status               TournamentStatus       @default(UPCOMING)
  isActive             Boolean                @default(true)
  isRegistrationOpen   Boolean                @default(true)
  isRosterLocked       Boolean                @default(false) // Khóa danh sách VĐV toàn giải trước giờ thi đấu
  requireBirthYear     Boolean                @default(false) // Yêu cầu nhập năm sinh từng VĐV khi đăng ký
  maxTeams             Int                    @default(8)
  registrationDeadline String?                // YYYY-MM-DD
  startDate            String                 // YYYY-MM-DD
  endDate              String?                // YYYY-MM-DD
  startTime            String?                // HH:mm (VD: "07:30")
  endTime              String?                // HH:mm (VD: "19:00")
  location             String                 @default("155 Truong Chinh, Thanh Xuan, Hanoi (DVA Court - BTL Thong Tin)")
  mapsUrl              String?
  bannerUrl            String?
  groupSetFormat       String                 @default("BO3") // "BO3" | "BO2"
  knockoutSetFormat    String                 @default("BO3") // "BO3" | "BO2"
  entryFeePerTeam      Int                    @default(0) // VNĐ (ép 0 nếu PARTICIPATING)
  internalExpenseNote  String?                @db.Text // Ghi chú quỹ/chi phí nội bộ (chỉ Admin xem)
  rulesContent         String?                @db.Text // Điều lệ giải (Markdown/Text)
  prizeConfig          Json?                  // [{ rank, label, cashAmount?, nonCashReward?, prizeMode? }]
  dvaResultSummary     String?                // VD: "3rd Place — FCB Open Cup 2025"
  podiumOverride       Json?                  // Podium & giải cá nhân tùy chỉnh cho DVA_FOCUS

  // Relations
  teams                TournamentTeam[]
  players              TournamentPlayer[]
  matches              TournamentMatch[]
  officials            TournamentOfficial[]

  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([isActive, status, startDate(sort: Desc)])
  @@index([mode, status])
  @@index([createdAt(sort: Desc)])
  @@map("tournaments")
}

/// Đội bóng tham dự giải đấu kèm trạng thái đóng lệ phí VietQR
model TournamentTeam {
  id                  String             @id @default(uuid())
  tournamentId        String
  tournament          Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name                String
  shortName           String?
  logoUrl             String?
  isDvaTeam           Boolean            @default(false)
  dvaSquadLevel       PlayerLevel?
  pool                String?            // "A" | "B" | null
  seedOrder           Int                @default(0)
  manualRankOverride  Int?
  finalRank           Int?
  captainName         String?
  captainPhone        String?
  captainEmail        String?
  paymentStatus       PaymentStatus      @default(PENDING)
  entryFeeAmount      Int                @default(0)
  transferContent     String?            @unique
  customerConfirmedAt DateTime?
  paidAt              DateTime?
  notes               String?            @db.Text

  // Relations
  players             TournamentPlayer[]
  homeMatches         TournamentMatch[]  @relation("HomeMatches")
  awayMatches         TournamentMatch[]  @relation("AwayMatches")
  wonMatches          TournamentMatch[]  @relation("WonMatches")

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([tournamentId, pool, seedOrder])
  @@index([tournamentId, paymentStatus])
  @@index([paymentStatus, paidAt(sort: Desc)])
  @@map("tournament_teams")
}

/// Danh sách VĐV thi đấu trong từng đội (7-10 VĐV) kèm danh hiệu cá nhân
model TournamentPlayer {
  id             String             @id @default(uuid())
  teamId         String
  team           TournamentTeam     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tournamentId   String
  tournament     Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  linkedPlayerId String?
  fullName       String
  jerseyNumber   Int                @default(0)
  position       VolleyballPosition @default(OH)
  height         Float?
  spikeTouch        Float?
  avatarUrl         String?
  birthYear         Int?               // Năm sinh VĐV (strip khỏi mọi API Public)
  eligibilityStatus String             @default("VERIFIED") // PENDING_CHECK | VERIFIED | FLAGGED | REJECTED
  rejectionReason   String?            // Lý do từ chối / gắn cờ nội bộ Admin (strip khỏi API Public)
  isCaptain         Boolean            @default(false)
  awards         String[]           @default([])

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([teamId, jerseyNumber(sort: Asc)])
  @@index([tournamentId])
  @@map("tournament_players")
}

/// Trận đấu vòng bảng & loại trực tiếp (hỗ trợ 2 sân song song và tỉ số từng set)
model TournamentMatch {
  id                   String              @id @default(uuid())
  tournamentId         String
  tournament           Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matchCode            String
  stage                MatchStage          @default(POOL_A)
  bracketSide          String?             // "LEFT" | "RIGHT" | "CENTER" | null
  courtName            String              @default("Court 1")
  scheduledTime        String?             // HH:mm
  matchOrder           Int                 @default(0)
  status               MatchStatus         @default(SCHEDULED)
  setFormat            String              @default("BO3")
  homeTeamId           String?
  homeTeam             TournamentTeam?     @relation("HomeMatches", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeamId           String?
  awayTeam             TournamentTeam?     @relation("AwayMatches", fields: [awayTeamId], references: [id], onDelete: SetNull)
  homeLabel            String?
  awayLabel            String?
  setScores            Json                @default("[]")
  homeSetsWon          Int                 @default(0)
  awaySetsWon          Int                 @default(0)
  homePointsTotal      Int                 @default(0)
  awayPointsTotal      Int                 @default(0)
  winnerTeamId         String?
  winnerTeam           TournamentTeam?     @relation("WonMatches", fields: [winnerTeamId], references: [id], onDelete: SetNull)
  officialId           String?
  official             TournamentOfficial? @relation("PrimaryOfficial", fields: [officialId], references: [id], onDelete: SetNull)
  assistantOfficialIds String[]            @default([])
  notes                String?             @db.Text

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([tournamentId, matchOrder(sort: Asc)])
  @@index([tournamentId, stage, status])
  @@index([officialId])
  @@map("tournament_matches")
}

/// Tổ trọng tài điều hành giải đấu
model TournamentOfficial {
  id             String            @id @default(uuid())
  tournamentId   String
  tournament     Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  fullName       String
  role           OfficialRole      @default(MAIN_REFEREE)
  certification  String?
  avatarUrl      String?
  phone          String?
  sortOrder      Int               @default(0)

  // Relations
  primaryMatches TournamentMatch[] @relation("PrimaryOfficial")

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([tournamentId, sortOrder(sort: Asc)])
  @@map("tournament_officials")
}

// ============================================================================
// HANOI VOLLEYBALL COURT MAP & CLUB PROFILES MODULE
// ============================================================================

/// Địa điểm sân bóng chuyền / nhà thi đấu tại Hà Nội
model VolleyballVenue {
  id              String              @id @default(uuid())
  name            String
  slug            String?
  address         String
  city            String              @default("Hà Nội")
  district        String
  latitude        Float
  longitude       Float
  surfaceType     String              // "Sàn thảm PVC" | "Sàn gỗ" | "Sân xi măng / Ngoài trời"
  subCourtsCount  Int                 @default(2)
  venueType       String              @default("COMMERCIAL") // "COMMERCIAL" | "FREE_PUBLIC"
  rentalPriceInfo String?             // VD: "550.000đ / giờ / sân" hoặc "Miễn phí — Tự đến xin ghép đội"
  entryNote       String?             @db.Text
  isDvaOfficial   Boolean             @default(false)
  isFeatured      Boolean             @default(false)
  isClosed        Boolean             @default(false)
  closureReason   String?             @db.Text
  closedUntil     DateTime?
  imageUrl        String?             // Legacy column preserved for additive-only compatibility
  coverUrl        String?

  // Relations
  clubs           CourtClubProfile[]
  sessions        VenueSessionSlot[]
  teams           VenueTeamSchedule[] // Legacy relation preserved for additive-only compatibility

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([slug])
  @@index([isDvaOfficial(sort: Desc), isFeatured(sort: Desc), name(sort: Asc)])
  @@index([city])
  @@index([district])
  @@index([venueType])
  @@map("volleyball_venues")
}

/// Hồ sơ chi tiết Đội / CLB hoạt động tại sân (có trang chi tiết /services/court-map/teams/:slug)
model CourtClubProfile {
  id           String             @id @default(uuid())
  venueId      String
  venue        VolleyballVenue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  name         String
  slug         String             @unique

  // Nhận diện hình ảnh (Cloudinary)
  logoUrl          String?
  coverUrl         String?
  galleryUrls      String[]           @default([])
  coverUpdatedAt   DateTime?
  galleryUpdatedAt DateTime?

  // Liên hệ Đội trưởng
  captainName   String
  captainPhone  String
  captainZalo   String?
  captainEmail  String?
  captainUserId String?            @unique
  captainUser   User?              @relation(fields: [captainUserId], references: [id], onDelete: SetNull)

  // Tính chất, Tag & Phí tham gia
  playStyle    String             @default("FUN_GAME") // "COMPETITIVE" | "FUN_GAME" | "TRAINING"
  tags         String[]           @default([])
  description  String?            @db.Text
  feeType      String             @default("PAID") // "PAID" | "FREE"
  feeAmount    String?
  isActive     Boolean            @default(true)

  // Relations
  sessions     VenueSessionSlot[]

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([venueId, isActive])
  @@index([playStyle])
  @@map("court_club_profiles")
}

/// Từng ca sinh hoạt cụ thể theo Thứ, Giờ & Sân con (Court A, Court B...)
model VenueSessionSlot {
  id                String           @id @default(uuid())
  venueId           String
  venue             VolleyballVenue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  clubId            String
  club              CourtClubProfile @relation(fields: [clubId], references: [id], onDelete: Cascade)

  daysOfWeek        Int[]            // 1=T2, 2=T3, 3=T4, 4=T5, 5=T6, 6=T7, 0=CN
  startTime         String           // HH:mm (VD: "19:00")
  endTime           String           // HH:mm (VD: "21:30")
  subCourts         String[]         @default(["Court A"]) // VD: ["Court A"], ["Court B"], ["Court A", "Court B"]
  recruitmentStatus String           @default("CHECK_CAPTAIN") // "OPEN_RECRUIT" | "CHECK_CAPTAIN" | "FULL"
  isCancelled       Boolean          @default(false)
  cancelledDates    String[]         @default([]) // Ngày nghỉ cụ thể YYYY-MM-DD (Asia/Ho_Chi_Minh)
  cancelReason      String?
  capacityMode      String           @default("UNLIMITED") // "UNLIMITED" | "LIMITED_SLOTS"
  currentPlayers    Int              @default(0)
  maxPlayers        Int              @default(14)
  neededPositions   String[]         @default([]) // "OH" | "MB" | "OP" | "S" | "L"
  dailyOverrides    Json             @default("{}") // { "YYYY-MM-DD": { currentPlayers, neededPositions } }
  genderRule        String           @default("MIXED") // "MALE_ONLY" | "MIXED" | "FEMALE_ONLY"

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([venueId])
  @@index([clubId])
  @@map("venue_session_slots")
}

/// Legacy v1 table preserved for strictly additive-only schema evolution
model VenueTeamSchedule {
  id                String          @id @default(uuid())
  venueId           String
  venue             VolleyballVenue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  teamName          String
  captainName       String
  captainPhone      String
  captainZalo       String?
  daysOfWeek        Int[]
  startTime         String
  endTime           String
  playStyle         String          @default("FUN_GAME")
  notes             String?         @db.Text
  skillLevel        String
  feeInfo           String
  recruitmentStatus String          @default("CHECK_CAPTAIN")
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([venueId, isActive])
  @@index([playStyle])
  @@map("venue_team_schedules")
}
